# Supabase (EU-hosted project) — create at https://supabase.com, region: EU
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mollie (payments) — server-side only, never exposed to the client
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# Transactional email (e.g. Resend)
RESEND_API_KEY=

# Server-side only — used by the Mollie webhook to write payments/invoices
SUPABASE_SERVICE_ROLE_KEY=

# Protects the Vercel cron endpoints (any long random string)
CRON_SECRET=

# Cloudflare Turnstile (bot protection on sign-up). The SECRET key is NOT
# set here: paste it in Supabase -> Authentication -> Bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public site URL (used in e-mails and Mollie redirects). Optional: derived from the request when unset.
NEXT_PUBLIC_APP_URL=
